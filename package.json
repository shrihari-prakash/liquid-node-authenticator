{
  "name": "liquid-node-authenticator",
  "version": "1.1.20",
  "description": "A Node.js connector library to integrate your microservices with Liquid authentication services.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "lint": "tsc --noEmit",
    "test": "mocha \"tests/**/*.tests.ts\"",
    "test:coverage": "NODE_ENV=test c8 --all --include=lib/* --reporter=html --reporter=text npm test",
    "test:watch": "npm test -- --watch",
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "targets": "> 0.25%, not dead",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shrihari-prakash/liquid-node-authenticator.git"
  },
  "keywords": [
    "npm",
    "package",
    "template",
    "javascript"
  ],
  "author": "Shrihari Prakasam <shrihariprakash@outlook.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/shrihari-prakash/liquid-node-authenticator/issues"
  },
  "engines": {
    "node": ">= 14.x"
  },
  "files": [
    "dist",
    "API.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "homepage": "https://github.com/shrihari-prakash/liquid-node-authenticator#readme",
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.1",
    "@types/sinon": "^21.0.1",
    "c8": "^9.1.0",
    "chai": "^4.3.10",
    "jsdoc": "^4.0.2",
    "mocha": "^10.2.0",
    "sinon": "^22.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  }
}
